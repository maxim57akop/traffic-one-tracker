# Copy this file to .env before production deploy:
#   cp .env.example .env

# Local default. For a real Cloudflare proxied domain, set this to 80.
APP_PORT=8080

# Public URL used when a campaign has no custom domain selected.
# For Cloudflare Flexible this is still the external HTTPS URL.
NEXT_PUBLIC_TRACKER_URL=https://traffic.example.com

# Browser API calls should stay relative so they work on any domain behind nginx.
NEXT_PUBLIC_API_URL=/api

# First admin user is created only when the database has no admin yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=padj9adsh3KAD
ADMIN_NAME=Admin
ADMIN_TEAM=TrafficOne Team

# Database credentials used inside Docker network.
POSTGRES_DB=trafficone
POSTGRES_USER=trafficone
POSTGRES_PASSWORD=change-me-db-password

CLICKHOUSE_DB=trafficone
REDIS_CAMPAIGN_PREFIX=campaign:

# Optional, mostly for DNS status hints in the Domains screen.
SERVER_IP=127.0.0.1

# For production, restrict this to your public origin if needed:
# CORS_ALLOW_ORIGIN=https://traffic.example.com
CORS_ALLOW_ORIGIN=*
